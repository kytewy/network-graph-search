{
  "name": "network-graph-search",
  "version": "1.0.0",
  "private": true,
  "description": "Semantic document search with interactive graph visualization and AI-powered clustering using Next.js and Reagraph",
  "keywords": [
    "network-graph",
    "semantic-search",
    "document-visualization",
    "reagraph",
    "nextjs",
    "clustering",
    "tf-idf",
    "pinecone",
    "knowledge-graph",
    "rag"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kytewy/network-graph-search"
  },
  "license": "MIT",
  "author": "Wyatt Kyte",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "diff:size": "bash scripts/diff-size.sh",
    "docker:build": "docker build -t network-graph-search .",
    "docker:run": "docker run -p 3000:3000 -e NODE_ENV=production -e PYTHON_PATH=/usr/bin/python3 network-graph-search"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
