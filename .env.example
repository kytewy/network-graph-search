# Pinecone Configuration
# Get your API key from: https://www.pinecone.io/

# Required: Your Pinecone API key
PINECONE_API_KEY=your_pinecone_api_key_here

# Optional: Index name (defaults to 'network-graph' if not set)
PINECONE_INDEX_NAME=network-graph

# Optional: Index host URL (leave empty to use default)
PINECONE_INDEX_HOST=

# Optional: Namespace for your vectors (defaults to 'example-namespace' if not set)
PINECONE_NAMESPACE=example-namespace

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Security
# Tag editing writes to Pinecone. It is always on in development; in
# production it is off unless this is set to true.
ALLOW_TAG_WRITES=false

# Debugging
# Set to true to print debug logs in the browser console and server output.
NEXT_PUBLIC_DEBUG=false
